# Default: LF line endings.
* text=auto eol=lf

# Force LF for files where CRLF breaks execution (Unix scripts, Docker).
*.sh text eol=lf
Dockerfile text eol=lf

# Force CRLF for files where LF breaks execution (Windows scripts).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psd1 text eol=crlf
*.psm1 text eol=crlf

# Force common binary formats.
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.tgz binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary

# Exclude git configurations.
/.gitattributes export-ignore
/.gitignore export-ignore
/.pre-commit-config.yaml export-ignore
/.pre-commit/ export-ignore

# Exclude CI/CD configurations.
/.circleci/ export-ignore
/.github/ export-ignore
/.gitlab-ci.yml export-ignore
/.travis.yml export-ignore

# Exclude dependency-updater configurations.
# (dependabot's own config lives under .github/, already excluded above, and so
# are Renovate's own .github/ spellings; these are the repository-root ones
# Renovate documents.)
/renovate.json export-ignore
/renovate.jsonc export-ignore
/renovate.json5 export-ignore
/.renovaterc export-ignore
/.renovaterc.json export-ignore
/.renovaterc.jsonc export-ignore
/.renovaterc.json5 export-ignore
# The code owners the updates are assigned or sent for review to.
/CODEOWNERS export-ignore

# Exclude environment configurations.
/.env.example export-ignore

# Exclude Docker configurations.
/.devcontainer/ export-ignore
/docker-compose.yml export-ignore

# Exclude formatter and linter configurations.
/.editorconfig export-ignore
/.markdownlint-cli2.jsonc export-ignore
/.prettierrc export-ignore
/.prettierrc.json5 export-ignore
/.prettierignore export-ignore
/biome.json export-ignore
/eslint.config.js export-ignore
/eslint.config.mjs export-ignore
/eslint.config.mts export-ignore
/.eslintrc.json export-ignore

# Exclude package-manager configurations.
/.npmrc export-ignore
/.yarnrc.yml export-ignore
/.node-version export-ignore

# Exclude IDE configurations.
/.idea/ export-ignore
/.vscode/ export-ignore
